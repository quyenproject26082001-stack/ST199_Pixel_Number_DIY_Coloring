<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/colorCard"
    android:layout_width="58dp"
    android:layout_height="64dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/white"
    app:strokeWidth="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:id="@+id/tvColorNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvColorProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
