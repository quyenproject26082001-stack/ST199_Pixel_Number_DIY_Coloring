<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.cosplay.CosplaySuccessfulActivity">


    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:id="@+id/starSS"
        android:layout_width="@dimen/dp_226"
        android:layout_height="@dimen/dp_48"
        android:visibility="gone"
        android:src="@drawable/four_star_ss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerVS"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toTopOf="@id/progressContainer"
        app:layout_constraintTop_toBottomOf="@id/starSS">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHalf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHalf1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHalfV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHalfV1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.4" />

        <!--    cvImage-->
        <FrameLayout
            android:id="@+id/cvImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_img_character_sample"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/guidelineHalf"
            app:layout_constraintDimensionRatio="1:1"

            app:layout_constraintEnd_toEndOf="@id/guidelineHalfV"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dp_3"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_8"
                app:cardBackgroundColor="#586B8C"
                app:cardCornerRadius="@dimen/dp_10"
                app:layout_constraintDimensionRatio="156:152"
                app:strokeColor="@color/transparent">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dp_3"
                    app:cardBackgroundColor="@color/app1"
                    app:cardCornerRadius="@dimen/dp_7"
                    app:strokeColor="@color/transparent">

                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        tools:src="@color/black"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/containerBtnSamplePhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="@dimen/dp_16"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_img_character_sample"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/guidelineHalfV1"
            app:layout_constraintTop_toBottomOf="@id/guidelineHalf1"
            app:layout_constraintVertical_bias="0">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dp_3"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_8"
                app:cardBackgroundColor="#586B8C"
                app:cardCornerRadius="@dimen/dp_10"
                app:layout_constraintDimensionRatio="156:152"
                app:strokeColor="@color/transparent">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dp_3"
                    app:cardBackgroundColor="@color/app1"
                    app:cardCornerRadius="@dimen/dp_7"
                    app:strokeColor="@color/transparent">

                    <ImageView
                        android:id="@+id/btnSamplePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        tools:src="@color/dark" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/vsImg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_35"
            android:background="@drawable/vs_img"
            app:layout_constraintBottom_toBottomOf="@id/containerBtnSamplePhoto"
            app:layout_constraintDimensionRatio="291:284"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cvImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <FrameLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_35"
        android:visibility="invisible"
        android:layout_marginBottom="@dimen/dp_5"
        android:background="@drawable/bg_progress_container2_h"
        app:layout_constraintBottom_toTopOf="@id/tvProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <ImageView
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:background="@drawable/bg_progress_1_h"
            app:layout_constraintBottom_toTopOf="@id/btnMan"
            app:layout_constraintEnd_toEndOf="parent" />

    </FrameLayout>

    <TextView

        android:id="@+id/ic_thumb"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/ic_thumb"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        android:visibility="invisible"
        tools:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/progressContainer"
        app:layout_constraintStart_toStartOf="@id/progressContainer"
        app:layout_constraintTop_toTopOf="@id/progressContainer" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_20"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        android:text="10/100"
        android:visibility="invisible"
        android:textColor="@color/app"
        android:textSize="@dimen/sp_20"
        app:layout_constraintBottom_toTopOf="@id/lnlBottom"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/progressContainer" />

    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="320:360"
        android:background="@drawable/frame1"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:id="@+id/ctnSS"
        >
        <ImageView
            android:id="@+id/imageSS"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:background="@drawable/frame2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/score"
            android:textColor="#B25324"
            android:textSize="@dimen/sp_28"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:id="@+id/tvRef"
            app:layout_constraintTop_toBottomOf="@id/imageSS"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/ctnBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_16"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ctnSS">

        <FrameLayout
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_random_btn">

            <TextView
                android:id="@+id/tvRetry"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/game_paused_demo_regular"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_2"
                android:text="@string/retry"
                android:textColor="@color/white"

                android:textSize="@dimen/sp_16"
                android:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_random_cosplay"
            app:layout_constraintDimensionRatio="328:56">

            <TextView
                android:id="@+id/tvDownload"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/game_paused_demo_regular"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_2"
                android:text="@string/download"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                android:visibility="visible" />
        </FrameLayout>

    </LinearLayout>
    
    <!--    lnlBottom-->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_60"
        android:paddingHorizontal="@dimen/dp_15"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">
        <include
            android:id="@+id/includeLayoutBottom"
            layout="@layout/layout_bottom_cosplay" />
    </FrameLayout>


    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/ads_shimmer_collap_native" />
    </FrameLayout>


    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
    <!--    <FrameLayout-->
    <!--        android:id="@+id/flNativeCollab"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent">-->

    <!--    </FrameLayout>-->


</androidx.constraintlayout.widget.ConstraintLayout>
