<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <RelativeLayout
        android:background="@drawable/bg_native_hide"
        android:id="@+id/ad_unit_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/rl_collap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dp_120"
                android:orientation="horizontal">
                <RelativeLayout
                    android:id="@+id/rlmedia"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/ad_media"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal" />
                </RelativeLayout>
                <TextView
                    android:layout_marginLeft="@dimen/dp_minus_20"
                    android:layout_toRightOf="@+id/rlmedia"
                    style="@style/AppTheme.Ads2" />
                <LinearLayout
                    android:gravity="center"
                   android:layout_toRightOf="@+id/rlmedia"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_8"
                        android:layout_marginRight="@dimen/dp_8"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ad_headline"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/native_text_title"
                            android:textSize="@dimen/sp_15" />

                        <LinearLayout
                            android:layout_marginTop="@dimen/dp_5"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:textColor="@color/native_text_body"
                                android:layout_marginLeft="@dimen/dp_5"
                                android:id="@+id/ad_body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:textSize="@dimen/sp_10" />
                        </LinearLayout>
                    </LinearLayout>
                     <ImageView
                        android:layout_marginEnd="@dimen/dp_10"
                        android:id="@+id/ad_call_to_action"
                        android:layout_width="wrap_content"
                        android:maxWidth="@dimen/dp_110"
                        android:minWidth="@dimen/dp_100"
                        android:layout_height="@dimen/dp_45"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:textColor="@color/native_ad_text_color_banner" />

                </LinearLayout>

            </RelativeLayout>


        </LinearLayout>
    </RelativeLayout>


</com.facebook.shimmer.ShimmerFrameLayout>