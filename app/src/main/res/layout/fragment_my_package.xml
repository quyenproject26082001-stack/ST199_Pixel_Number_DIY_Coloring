<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEED2"
    android:clipToPadding="false"
    android:paddingTop="0dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvMyPackage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:paddingHorizontal="8.5dp"
        android:paddingBottom="100dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:listitem="@layout/item_package" />

    <LinearLayout
        android:id="@+id/layoutNoItem"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNoitem"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:paddingHorizontal="33dp"
            android:text="@string/no_creations_yet"
            android:textColor="@color/app"
            android:textSize="16sp"
            android:translationY="0dp" />
    </LinearLayout>
</FrameLayout>
