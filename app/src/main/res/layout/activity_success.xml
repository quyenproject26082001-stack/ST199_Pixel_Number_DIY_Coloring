<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.success.SuccessActivity">


    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/cvImage"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cvImage" />
    <!--    cvImage-->
    <FrameLayout
        android:id="@+id/cvImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvSuccess"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:strokeColor="@color/transparent">

        <!--        imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnCreation"
        android:layout_width="144dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_btn_ss"
        android:paddingHorizontal="5dp"
        app:layout_constraintEnd_toStartOf="@id/btnDownload"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDownload">

        <TextView
            android:id="@+id/tvCreation"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/my_creation"
            android:textColor="@color/app"
            android:textSize="16sp" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnDownload"
        android:layout_width="144dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ic_btn_ss"
        android:paddingHorizontal="5dp"
        android:layout_marginBottom="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCreation"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDownload"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/download"
            android:textColor="@color/app"
            android:textSize="16sp" />

    </FrameLayout>


    <TextView
        android:id="@+id/tvSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:includeFontPadding="false"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        android:text="@string/image_has_been_saved_successful"
        android:textColor="@color/app"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/cvImage"
        app:layout_constraintVertical_bias="0" />


    <!--    lnlBottom-->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="-10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvSuccess">

        <include
            android:id="@+id/includeLayoutBottom"
            layout="@layout/layout_bottom_ss" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/ads_native_big_btn_bottom_shimmer" />

    </FrameLayout>


