<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.success.SuccessActivity">


    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/cvImage"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cvImage" />
    <!--    cvImage-->
    <FrameLayout
        android:id="@+id/cvImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"
        android:visibility="visible"
        app:layout_constraintVertical_bias="0.17094017094"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/transparent">

        <!--        imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnCreation"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_44"
        android:background="@drawable/bg_btn_ss1"
        android:paddingHorizontal="@dimen/dp_5"
        app:layout_constraintEnd_toStartOf="@id/btnShareSuccess"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnShareSuccess">

        <TextView
            android:id="@+id/tvCreation"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_1"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/my_work"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnShareSuccess"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@drawable/bg_btn_ss2"
        android:paddingHorizontal="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCreation"
        app:layout_constraintTop_toBottomOf="@id/cvImage"
        >

        <TextView
            android:id="@+id/tvShare"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_1"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/share"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

    </FrameLayout>


    <TextView
        android:id="@+id/tvSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:includeFontPadding="false"
        android:layout_marginBottom="@dimen/dp_10"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        android:text="@string/image_has_been_saved_successful"
        android:textColor="@color/app"
        android:textSize="@dimen/sp_16"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cvImage"
        app:layout_constraintVertical_bias="0" />


    <!--    lnlBottom-->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginBottom="@dimen/dp_minus_10"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvSuccess">

        <include
            android:id="@+id/includeLayoutBottom"
            layout="@layout/layout_bottom_ss" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/ads_native_big_btn_bottom_shimmer" />

    </FrameLayout>


    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
    <!--    <FrameLayout-->
    <!--        android:id="@+id/flNativeCollab"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent">-->

    <!--        <include layout="@layout/ads_shimmer_collap_native" />-->
    <!--    </FrameLayout>-->


