<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24">

    <FrameLayout
        android:id="@+id/btnViewShare"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_44"
        android:background="@drawable/ic_btn_ss1"


        android:paddingHorizontal="@dimen/dp_5"
        android:layout_marginBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnDownload"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvShare"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_1"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/share"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnDownload"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_44"
        android:background="@drawable/ic_btn_ss"
        android:paddingHorizontal="@dimen/dp_5"
        app:layout_constraintEnd_toStartOf="@id/btnViewShare"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnViewShare"
  >

        <TextView
            android:id="@+id/tvDownload"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_1"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/download"
            android:textColor="@color/app"
            android:textSize="@dimen/sp_16" />

    </FrameLayout>


    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/GLCenter"
        app:layout_constraintGuide_percent="0.5"
        android:orientation="vertical"/>

</androidx.constraintlayout.widget.ConstraintLayout>
