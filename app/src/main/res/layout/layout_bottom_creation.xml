<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="44dp">

    <FrameLayout
        android:id="@+id/btnViewShare"
        android:layout_width="144dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_btn_ss"
        android:paddingHorizontal="5dp"
        app:layout_constraintEnd_toStartOf="@id/btnDownload"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDownload">

        <TextView
            android:id="@+id/tvShare"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/share"
            android:textColor="@color/app"
            android:textSize="16sp" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnDownload"
        android:layout_width="144dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ic_btn_ss"
        android:paddingHorizontal="5dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnViewShare"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDownload"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/download"
            android:textColor="@color/app"
            android:textSize="16sp" />

    </FrameLayout>


    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/GLCenter"
        app:layout_constraintGuide_percent="0.5"
        android:orientation="vertical"/>

</androidx.constraintlayout.widget.ConstraintLayout>
