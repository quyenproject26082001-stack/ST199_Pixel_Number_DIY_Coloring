<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".ui.my_creation.MyCreationActivity">




    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/bg_app"/>

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    &lt;!&ndash;    native_ads&ndash;&gt;-->
        <FrameLayout
            android:id="@+id/native_ads"
        android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

            <include layout="@layout/ads_native_collap_banner_shimmer" />
        </FrameLayout>



    <!--    frmList-->
    <!--    cvType-->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/frmList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="#D2F7FF"
        android:paddingTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvType"
        app:layout_constraintVertical_bias="0.0"
        app:layout_goneMarginTop="0dp"
        android:clipChildren="true"
        tools:background="@drawable/bg_down"
        tools:layout_editor_absoluteX="0dp" />

    <FrameLayout
        android:id="@+id/cvType"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:cardBackgroundColor="@android:color/transparent"
        android:layout_marginTop="6dp"
    android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/native_ads"
        app:strokeColor="@color/transparent"
        app:strokeWidth="0dp"
        app:cardElevation="0dp">

        <!-- background tab full-width, đổi src theo tab được chọn -->
        <ImageView
            android:id="@+id/imvTabBackground"
            android:layout_width="match_parent"
            tools:background="@drawable/bg_avatar_slt"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!--            btnMyPixel-->
            <FrameLayout
                android:id="@+id/btnPK"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

            <com.skin.rbx.clothes.makek.core.custom.text.OuterStrokeTextView
                android:id="@+id/tvPK"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/game_paused_demo_regular"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:text="@string/my_package"
                android:textColor="@color/app"
                android:textSize="16sp" />
            </FrameLayout>

            <!--            btnMyPixel-->
            <FrameLayout
                android:id="@+id/btnMyPixel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.skin.rbx.clothes.makek.core.custom.text.OuterStrokeTextView
                    android:id="@+id/tvMyPride"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:layout_marginEnd="5dp"
                    android:text="@string/my_rbx"
                    android:textColor="@color/app"
                    android:textSize="16sp" />

            </FrameLayout>

            <!--            btnMyDesign-->
            <FrameLayout
                android:id="@+id/btnMyDesign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.skin.rbx.clothes.makek.core.custom.text.OuterStrokeTextView
                    android:id="@+id/tvMyDesign"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:text="@string/my_design"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/app"
                    android:textSize="16sp" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!--    flBottomView (share/download - shown in select mode) -->
    <FrameLayout
        android:id="@+id/flBottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp"
        android:elevation="2dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/bottomView"
            layout="@layout/layout_bottom_creation" />

    </FrameLayout>

    <!--    lnlBottom (whatsapp/telegram) -->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:paddingHorizontal="0dp"
        android:elevation="1dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/flBottomView"
        app:layout_goneMarginBottom="44dp">

        <include layout="@layout/layout_bottom" />

    </FrameLayout>


    <!--    &lt;!&ndash;    flNativeCollab&ndash;&gt;-->
        <FrameLayout
            android:id="@+id/flNativeCollab"
        android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

        </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
