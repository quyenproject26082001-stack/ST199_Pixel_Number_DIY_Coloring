<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">


        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="328dp"
                android:layout_height="210dp"
                android:background="@drawable/bg_dialog_delete_exit"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:elevation="1dp"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:text="@string/delete"
                    android:textColor="@color/app"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="dele" />
                <!--            tvDescription-->
                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/do_you_want_to_exit"
                    android:textColor="@color/app"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:gravity="center"
                    app:layout_constraintVertical_bias="1"
                    android:layout_marginBottom="25dp"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription">

                    <!--                    btnYes-->
                    <ImageView
                        android:id="@+id/icYesbg"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_yes_bg"
                        android:translationY="1dp"
                        android:scaleType="fitXY"
                        app:layout_constraintTop_toTopOf="@id/btnYes"
                        app:layout_constraintBottom_toBottomOf="@id/btnYes"
                        app:layout_constraintStart_toStartOf="@id/btnYes"
                        app:layout_constraintEnd_toEndOf="@id/btnYes"/>

                    <!--                    btnNo-->
                    <TextView
                        android:id="@+id/btnYes"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/yes"
                        app:layout_constraintEnd_toStartOf="@id/btnNo"
                        android:textColor="@color/app"
                        android:textSize="16sp" />

                    <!--                    btnYes-->
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_no_bg"
                        android:translationY="1dp"
                        app:layout_constraintTop_toTopOf="@id/btnNo"
                        app:layout_constraintBottom_toBottomOf="@id/btnNo"
                        app:layout_constraintStart_toStartOf="@id/btnNo"
                        app:layout_constraintEnd_toEndOf="@id/btnNo"/>

                    <TextView
                        android:id="@+id/btnNo"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:layout_constraintStart_toEndOf="@id/btnYes"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/no"
                        android:textColor="@color/app"
                        android:textSize="16sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
