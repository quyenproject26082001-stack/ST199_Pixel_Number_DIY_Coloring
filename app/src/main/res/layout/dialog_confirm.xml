<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">


        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="@dimen/dp_328"
                android:layout_height="@dimen/dp_204"
                android:background="@drawable/bg_dl"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:id="@+id/ctnTitle"
                    android:layout_width="@dimen/dp_328"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_height="@dimen/dp_64">
                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dp_16"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:elevation="@dimen/dp_1"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/delete"
                    android:textColor="@color/app"
                    android:textSize="@dimen/sp_26"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="dele" />
                </FrameLayout>
                <!--            tvDescription-->
                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingHorizontal="@dimen/dp_24"
                    android:text="@string/do_you_want_to_exit"
                    android:textColor="@color/app"
                    android:textSize="@dimen/sp_20"
                    tools:text="asdasjd"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:gravity="center"
                    app:layout_constraintVertical_bias="1"
                    android:layout_marginBottom="@dimen/dp_25"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription">

                    <!--                    btnYes-->
                    <ImageView
                        android:id="@+id/icYesbg"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/ic_yes_bg"
                        android:scaleType="fitXY"
                        app:layout_constraintTop_toTopOf="@id/btnYes"
                        app:layout_constraintBottom_toBottomOf="@id/btnYes"
                        app:layout_constraintStart_toStartOf="@id/btnYes"
                        app:layout_constraintEnd_toEndOf="@id/btnYes"/>

                    <!--                    btnNo-->
                    <TextView
                        android:id="@+id/btnYes"
                        android:layout_width="@dimen/dp_130"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:layout_constraintStart_toEndOf="@id/btnNo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:gravity="center"
                        android:text="@string/yes"
                        android:layout_marginStart="@dimen/dp_8"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_16" />

                    <!--                    btnYes-->
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_36"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_no_bg"
                        app:layout_constraintTop_toTopOf="@id/btnNo"
                        app:layout_constraintBottom_toBottomOf="@id/btnNo"
                        app:layout_constraintStart_toStartOf="@id/btnNo"
                        app:layout_constraintEnd_toEndOf="@id/btnNo"/>

                    <TextView
                        android:id="@+id/btnNo"
                        android:layout_width="@dimen/dp_130"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnYes"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:gravity="center"
                        android:text="@string/no"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_16" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="@dimen/dp_42"
                android:layout_height="@dimen/dp_42"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
