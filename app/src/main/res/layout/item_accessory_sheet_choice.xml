<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_4">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_1"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="@dimen/dp_1"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/black"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_4"
            android:visibility="gone"
            tools:src="@drawable/ic_none_accessory" />

        <ImageView
            android:id="@+id/imvNoneAccessory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout_width="@dimen/dp_76"
            tools:layout_height="@dimen/dp_76"
            android:scaleY="0.57"
            android:scaleX="0.57"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_none_accessory"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="false"
            app:shimmer_base_alpha="0.65"
            app:shimmer_base_color="#4A4A4A"
            app:shimmer_direction="left_to_right"
            app:shimmer_duration="1800"
            app:shimmer_highlight_alpha="1"
            app:shimmer_highlight_color="@color/white"
            app:shimmer_shape="linear"
            app:shimmer_tilt="20">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4A4A4A" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
