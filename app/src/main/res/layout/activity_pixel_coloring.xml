<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_background"
    tools:context=".ui.pixel_coloring.PixelColoringActivity">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <include android:id="@+id/actionBar" layout="@layout/layout_actionbar" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/pixel_primary" />
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="end"
            android:text="@string/pixel_zero_percent"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/toolContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressContainer">
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelCanvasView
            android:id="@+id/pixelCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelMiniMapView
            android:id="@+id/miniMap"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_pixel_minimap"
            android:padding="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolContainer"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@id/paletteList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <Button
            android:id="@+id/btnWand"
            style="@style/PixelToolButton"
            android:text="@string/pixel_wand" />
        <Button
            android:id="@+id/btnBomb"
            style="@style/PixelToolButton"
            android:text="@string/pixel_bomb" />
        <Button
            android:id="@+id/btnHint"
            style="@style/PixelToolButton"
            android:text="@string/pixel_hint" />
        <Button
            android:id="@+id/btnResetZoom"
            style="@style/PixelToolButton"
            android:text="@string/pixel_reset" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/paletteList"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingVertical="6dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_pixel_color" />
</androidx.constraintlayout.widget.ConstraintLayout>
