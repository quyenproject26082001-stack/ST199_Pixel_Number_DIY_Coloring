<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.pixel_coloring.PixelColoringActivity">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_2"
        app:layout_constraintTop_toTopOf="parent">
        <include android:id="@+id/actionBar" layout="@layout/layout_actionbar" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/pixel_primary" />
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="@dimen/dp_48"
            android:layout_height="wrap_content"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="end"
            android:text="@string/pixel_zero_percent"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="@string/_1_1"

        android:background="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelCanvasView
            android:id="@+id/pixelCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelMiniMapView
            android:id="@+id/miniMap"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_120"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/dp_16"
            android:padding="@dimen/dp_6"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_56"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@id/paletteList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageButton
            android:id="@+id/btnWand"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:background="@null"
            android:contentDescription="@string/pixel_wand"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_range" />
        <ImageButton
            android:id="@+id/btnBomb"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:background="@null"
            android:contentDescription="@string/pixel_bomb"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_bomb" />
        <Button
            android:id="@+id/btnHint"
            style="@style/PixelToolButton"
            android:text="@string/pixel_hint"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnResetZoom"
            style="@style/PixelToolButton"
            android:text="@string/pixel_reset"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/paletteList"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_76"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_pixel_color" />
</androidx.constraintlayout.widget.ConstraintLayout>
