<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgLight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_50"
            tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        android:paddingHorizontal="@dimen/dp_30"
            android:layout_marginHorizontal="@dimen/dp_51"
            android:layout_marginBottom="@dimen/dp_minus_26"
            android:background="@drawable/bg_title"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            android:elevation="@dimen/dp_1"
            android:fontFamily="@font/game_paused_demo_regular"
            android:gravity="center"
            android:paddingVertical="@dimen/dp_5"
            android:text="@string/cosplay_results"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            app:layout_constraintBottom_toTopOf="@id/layoutMain"
            app:layout_constraintEnd_toEndOf="@id/layoutMain"
            app:layout_constraintStart_toStartOf="@id/layoutMain" />

        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="@dimen/dp_328"
                android:layout_height="@dimen/dp_338"
                android:background="@drawable/bg_dl"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">


                <!--            tvDescription-->
                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_38"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_24"
                    android:text="@string/your_cosplay_score"
                    android:textColor="#586B8C"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <FrameLayout
                    android:id="@+id/ctnImage"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/bg_img_character_sample"
                    android:visibility="visible"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@id/ctnSample"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription"
                    app:layout_constraintVertical_bias="0">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_3"
                        android:layout_marginTop="@dimen/dp_3"
                        android:layout_marginBottom="@dimen/dp_8"
                        app:cardBackgroundColor="#586B8C"
                        app:cardCornerRadius="@dimen/dp_7"
                        app:layout_constraintDimensionRatio="156:152"
                        app:strokeColor="@color/transparent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/dp_3"
                            app:cardBackgroundColor="@color/app1"
                            app:cardCornerRadius="@dimen/dp_7"
                            app:strokeColor="@color/transparent">

                            <ImageView
                                android:id="@+id/btnImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="0dp"
                                android:scaleType="fitCenter" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>


                <FrameLayout
                    android:id="@+id/ctnSample"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    android:layout_marginTop="@dimen/dp_26"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/bg_img_character_sample"
                    android:visibility="visible"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ctnImage"
                    app:layout_constraintTop_toTopOf="@id/ctnImage"
                    app:layout_constraintVertical_bias="0">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_3"
                        android:layout_marginTop="@dimen/dp_3"
                        android:layout_marginBottom="@dimen/dp_8"
                        app:cardBackgroundColor="#586B8C"
                        app:cardCornerRadius="@dimen/dp_7"
                        app:layout_constraintDimensionRatio="156:152"
                        app:strokeColor="@color/transparent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/dp_3"
                            app:cardBackgroundColor="@color/app1"
                            app:cardCornerRadius="@dimen/dp_7"
                            app:strokeColor="@color/transparent">

                            <ImageView
                                android:id="@+id/btnSamplePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="0dp"
                                android:scaleType="fitCenter" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_34"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:strokeColor="@color/app"
                        app:strokeWidth="@dimen/dp_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:cardBackgroundColor="#E8EDF7">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_100_match"
                        android:textSize="@dimen/sp_16"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:id="@+id/tvRef"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:textColor="@color/app"
                        tools:text="qqqqqqqqqqqq"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>
                
                
                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_33"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="156:40"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <!--                    btnYes-->
                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="@dimen/dp_88"
                        android:layout_height="@dimen/dp_44"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_weight="1"
                        android:background="@drawable/ic_no_dialog"
                        android:fontFamily="@font/game_paused_demo_regular"
                        android:gravity="center"
                        android:paddingVertical="@dimen/dp_9"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_18" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="@dimen/dp_42"
                android:layout_height="@dimen/dp_42"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
