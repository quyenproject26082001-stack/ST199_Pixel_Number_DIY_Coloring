<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.cosplay.CosplayCustomizeActivity">

    <!-- Blue background for upper area -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A1CCEF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/glHorizontal" />

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!-- tvCountDown -->
    <TextView
        android:id="@+id/tvCountDown"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_36"
        android:background="@drawable/bg_count_down2"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        android:text="10:00"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@id/layoutCustomLayerBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="@dimen/dp_81"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/ic_timing_shadow"
        app:layout_constraintEnd_toEndOf="@id/tvCountDown"
        app:layout_constraintStart_toStartOf="@id/tvCountDown"
        app:layout_constraintTop_toBottomOf="@id/tvCountDown" />
    <!-- layoutCustomLayer (render area) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintBottom_toBottomOf="@id/glHorizontal"
        android:background="#D9D9D9"
        />
    <FrameLayout
        android:id="@+id/layoutCustomLayerBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/glHorizontal"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintVertical_bias="0"
        app:strokeColor="#861629"
        app:strokeWidth="@dimen/dp_1"
        tools:background="@color/app">

        <FrameLayout
            android:id="@+id/layoutCustomLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- glHorizontal -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6" />

    <!-- btnFlip -->
    <ImageView
        android:id="@+id/btnFlip"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_flip"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <!-- btnHide -->
    <ImageView
        android:id="@+id/btnHide"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_show"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFlip" />

    <!-- containerBtnSamplePhoto (small reference image, top-left) -->
    <FrameLayout
        android:id="@+id/containerBtnSamplePhoto"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/frame_sample"
        android:visibility="visible"
        app:cardCornerRadius="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvCountDown"
        app:strokeColor="#861629">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnSamplePhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_2"
            android:layout_marginTop="@dimen/dp_2_5"
            android:layout_marginBottom="@dimen/dp_4"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/border_image_6"
            tools:src="@color/dark" />
    </FrameLayout>

    <!-- btnMan (gone) -->
    <TextView
        android:id="@+id/btnMan"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/selector_btn_man"
        android:elevation="@dimen/dp_1"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/color" />

    <!-- btnWooman (gone) -->
    <TextView
        android:id="@+id/btnWooman"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_12"
        android:background="@drawable/selector_btn_woman"
        android:elevation="@dimen/dp_1"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/btnMan"
        app:layout_constraintTop_toTopOf="@id/btnMan" />

    <!-- progressContainer -->
    <FrameLayout
        android:id="@+id/progressContainer"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_250"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/bg_progress_container2"
        android:clipToOutline="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layoutCustomLayerBackground">

        <ImageView
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_1"
            android:layerType="software" />
    </FrameLayout>

    <!-- tvThumbProgress -->
    <TextView
        android:id="@+id/ic_thumb"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/ic_thumb"
        android:elevation="@dimen/dp_1"
        android:visibility="gone"
        android:fontFamily="@font/game_paused_demo_regular"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/progressContainer"
        app:layout_constraintEnd_toEndOf="@id/progressContainer"
        app:layout_constraintStart_toStartOf="@id/progressContainer"
        app:layout_constraintTop_toTopOf="@id/progressContainer" />

    <TextView
        android:id="@+id/tvThumbProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:fontFamily="@font/fredoka"
        android:textColor="@color/app"
        android:textSize="@dimen/sp_16"
        app:layout_constraintEnd_toEndOf="@id/progressContainer"
        app:layout_constraintStart_toStartOf="@id/progressContainer"
        app:layout_constraintTop_toBottomOf="@id/progressContainer" />


    <!-- gl_btn -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/glHorizontal"
        android:background="@drawable/bg_bottom_cospla"/>

    <!-- color section (rcvColor) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btnRandom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/glHorizontal"
        tools:visibility="visible">

        <!-- btnColor -->
        <ImageView
            android:id="@+id/btnColor"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_39"
            android:src="@drawable/ic_color"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/flColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:elevation="@dimen/dp_1"
            android:gravity="start"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/btnColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnColor"
            app:layout_constraintTop_toTopOf="@+id/btnColor">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@color/transparent"
                app:cardCornerRadius="@dimen/dp_13_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardBackgroundColor="#B25324">
                >
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/relativeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:cardBackgroundColor="#FEBF7F"
                app:cardCornerRadius="@dimen/dp_12"
                android:layout_margin="@dimen/dp_1_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#FF8D19"
                app:strokeWidth="@dimen/dp_2">


                <RelativeLayout
                    android:id="@+id/relative"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dp_6">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/dp_4"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="50"
                        tools:listitem="@layout/item_color" />

                </RelativeLayout>


            </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- btnRandom -->
    <ImageView
        android:id="@+id/btnRandom"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_38_8"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="@dimen/dp_2"
        android:src="@drawable/ic_random"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glHorizontal" />

    <!-- bg_cus -->
    <TextView
        android:id="@+id/bg_cus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/color" />

    <!-- rcvLayer -->

    <!-- flBottomNav -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_4"
        android:clipToPadding="false"
        android:layerType="hardware"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_56"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/flBottomNav"
        app:layout_constraintTop_toTopOf="@id/glHorizontal"
        app:layout_constraintVertical_bias="1.0"
        app:spanCount="5"
        tools:itemCount="50"
        tools:layout_editor_absoluteX="0dp"
        tools:listitem="@layout/item_customize" />

    <FrameLayout
        android:id="@+id/flBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:background="#7F6040"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layerType="hardware"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/dp_8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_bottom_navigation" />
    </FrameLayout>

    <!-- btnOverLay (full-screen overlay to show sample photo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnOverLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="@dimen/dp_2"
        android:focusable="true"
        android:visibility="gone">


        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerBtnSamplePhotoShow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_116"
            android:background="@drawable/frame1"
            android:elevation="@dimen/dp_5"
            android:visibility="visible"
            app:cardCornerRadius="@dimen/dp_4"
            app:layout_constraintDimensionRatio="320:360"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#861629">

            <TextView
                android:id="@+id/tvRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B25324"
                android:textSize="@dimen/sp_28"
                android:text="80%"
                android:gravity="center"
                android:fontFamily="@font/game_paused_demo_regular"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ctnID"
                />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ctnID"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dp_24"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginBottom="@dimen/dp_64"
                app:cardCornerRadius="@dimen/dp_4"
                app:layout_constraintDimensionRatio="152:152"
                app:strokeColor="@color/transparent">

                    <ImageView
                        android:id="@+id/btnSamplePhotoShow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="0dp"
                        android:elevation="@dimen/dp_5"
                        android:scaleType="fitCenter"
                        tools:src="@color/white" />
                </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/btnCloseImage"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_24"
            android:background="@drawable/ic_close_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerBtnSamplePhotoShow" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_5"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
