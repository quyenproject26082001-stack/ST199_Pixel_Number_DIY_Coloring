<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.skin.rbx.clothes.makek.ui.SettingsActivity">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:scaleType="centerCrop" />


    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!--            btnLang-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnLang"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_frame_setting"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintDimensionRatio="328:56"
                app:layout_constraintTop_toTopOf="parent">

                <Space
                    android:id="@+id/sp0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.0731707317" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/imgLang"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_percent="0.42857142857"
                    app:layout_constraintStart_toEndOf="@id/sp0"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_lang_set" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Space
                    android:id="@+id/sp1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/imgLang"
                    app:layout_constraintWidth_percent="0.04268292682" />

                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="8"
                    android:autoSizeMaxTextSize="100sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="start|center"
                    android:text="@string/language"
                    android:textColor="@color/app"
                    android:textSize="20sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.35714285714"
                    app:layout_constraintStart_toEndOf="@id/sp1"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/arrow"
                    android:visibility="gone" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--            btnRate-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnRate"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_frame_setting"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintDimensionRatio="328:56"
                app:layout_constraintTop_toBottomOf="@id/btnLang">

                <Space
                    android:id="@+id/sp2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.0731707317" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/imgRate"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_percent="0.42857142857"
                    app:layout_constraintStart_toEndOf="@id/sp2"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_rate_set" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Space
                    android:id="@+id/sp3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/imgRate"
                    app:layout_constraintWidth_percent="0.04268292682" />

                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:autoSizeMaxTextSize="100sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="start|center"
                    android:text="@string/rate_us"
                    android:textColor="@color/app"
                    android:textSize="20sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.35714285714"
                    app:layout_constraintStart_toEndOf="@id/sp3"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:layout_marginStart="15dp"
                    android:background="@drawable/arrow"
                    android:visibility="gone" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--            btnShare-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnShareApp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_frame_setting"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintDimensionRatio="328:56"
                app:layout_constraintTop_toBottomOf="@id/btnRate">

                <Space
                    android:id="@+id/sp4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.0731707317" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/imgShare"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_percent="0.42857142857"
                    app:layout_constraintStart_toEndOf="@id/sp4"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_share_set" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Space
                    android:id="@+id/sp5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/imgShare"
                    app:layout_constraintWidth_percent="0.04268292682" />

                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:autoSizeMaxTextSize="100sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="start|center"
                    android:text="@string/share_app"
                    android:textColor="@color/app"
                    android:textSize="20sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.35714285714"
                    app:layout_constraintStart_toEndOf="@id/sp5"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:layout_marginStart="15dp"
                    android:background="@drawable/arrow"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--            btnPolicy-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnPolicy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_frame_setting"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintDimensionRatio="328:56"
                app:layout_constraintTop_toBottomOf="@id/btnShareApp">

                <Space
                    android:id="@+id/sp6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.0731707317" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/imgPolicy"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_percent="0.42857142857"
                    app:layout_constraintStart_toEndOf="@id/sp6"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_policy_set" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Space
                    android:id="@+id/sp7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/imgPolicy"
                    app:layout_constraintWidth_percent="0.04268292682" />

                <com.skin.rbx.clothes.makek.core.custom.text.DoubleStrokeTextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:autoSizeMaxTextSize="100sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/game_paused_demo_regular"
                    android:gravity="start|center"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/app"
                    android:textSize="20sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.35714285714"
                    app:layout_constraintStart_toEndOf="@id/sp7"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/arrow"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


    <!--    &lt;!&ndash;    flBanner&ndash;&gt;-->
    <!--    <FrameLayout-->
    <!--        android:id="@+id/flBanner"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent">-->

    <!--        <include-->
    <!--            android:id="@+id/includeBanner"-->
    <!--            layout="@layout/layout_banner" />-->
    <!--    </FrameLayout>-->
</androidx.constraintlayout.widget.ConstraintLayout>
