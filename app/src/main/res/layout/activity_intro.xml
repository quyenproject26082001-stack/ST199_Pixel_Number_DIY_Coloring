<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.intro.IntroActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
       android:background="@drawable/bg_app"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"
        android:orientation="horizontal"
        android:id="@+id/gl"
        />

    <!--    vpgTutorial-->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpgTutorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        tools:src="@layout/item_intro"
        app:layout_constraintBottom_toBottomOf="@id/gl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    dotsIndicator-->
    <ImageView
        android:id="@+id/dotsIndicator"
        android:layout_width="52dp"
        android:layout_height="8dp"
        app:layout_constraintTop_toTopOf="@id/btnNext"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_dot_1"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent" />

    <!--    btnNext-->
    <TextView
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/game_paused_demo_regular"
        android:padding="3dp"
        android:gravity="center"
        android:text="@string/next_intro"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/app"
        android:textSize="16sp"
        android:layout_marginBottom="90dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gl"
        />


<!--    &lt;!&ndash;    native_ads&ndash;&gt;-->
    <FrameLayout
        android:id="@+id/native_ads"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/ads_native_medium_btn_bottom_shimmer" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
