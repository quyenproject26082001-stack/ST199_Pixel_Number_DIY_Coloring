<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false"
    tools:context=".ui.outfit.OutfitViewerActivity">

    <!--    webView-->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_120"
        android:clipChildren="false"
        tools:background="@color/blue_app"
        android:background="@color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <!--    btnBack-->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="@id/ctnActionbar"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ctnActionbar" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ctnActionbar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_10"
            android:orientation="horizontal"
            android:padding="@dimen/dp_4"
            app:cardCornerRadius="@dimen/dp_20"
            app:strokeColor="@color/transparent"
            app:cardBackgroundColor="#E8E8E8"
            app:cardElevation="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="68:36"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="2"

                >

                <!--            btnThemeDark-->
                <ImageView
                    android:id="@+id/btnThemeDark"
                    android:layout_width="@dimen/dp_42"
                    android:layout_height="@dimen/dp_42"
                    android:layout_weight="1"
                    android:src="@drawable/ic_dark"
                    android:translationX="-0dp"
                    android:translationY="@dimen/dp_minus_1" />

                <!--            btnThemeLight-->
                <ImageView
                    android:id="@+id/btnThemeLight"
                    android:layout_width="@dimen/dp_42"
                    android:layout_height="@dimen/dp_42"
                    android:layout_weight="1"
                    android:src="@drawable/ic_light_selected"
                    android:translationX="0dp"
                    android:translationY="@dimen/dp_minus_1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--    btnDownload-->
        <FrameLayout
            android:id="@+id/btnDownload"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@drawable/ic_download1"
            app:layout_constraintBottom_toBottomOf="@id/ctnActionbar"
            app:layout_constraintDimensionRatio="62:36"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ctnActionbar">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/game_paused_demo_regular"
                android:gravity="center"
                android:text="@string/done"
                android:textColor="@color/app"
                android:textSize="@dimen/sp_16" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    lnlClothes-->
    <LinearLayout
        android:id="@+id/lnlClothes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_10"
        android:elevation="@dimen/dp_2"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--        btnShirt-->
        <ImageView
            android:id="@+id/btnShirt"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_46"
            android:src="@drawable/ic_shirt_uslt"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--        btnPant-->
        <ImageView
            android:id="@+id/btnPant"
            android:layout_width="@dimen/dp_42"

            android:layout_height="@dimen/dp_42"
            android:layout_marginTop="@dimen/dp_6"
            android:src="@drawable/ic_pant_uslt"
            android:visibility="gone"
            tools:visibility="gone" />

        <!--        btnAccessory-->
        <ImageView
            android:id="@+id/btnAccessory"
            android:layout_width="@dimen/dp_42"
            android:layout_height="@dimen/dp_42"
            android:layout_marginTop="@dimen/dp_6"
            android:src="@drawable/ic_assessory_uslt"
            android:visibility="gone" />
    </LinearLayout>

    <!--    lnlFeature-->
    <LinearLayout
        android:id="@+id/lnlFeature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_minus_3"
        android:background="@drawable/bg_26_solid_gray_e6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lnlClothes"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">


        <!--        btnClose-->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:src="@drawable/ic_close1" />
        <!--        btnText-->
        <ImageView
            android:id="@+id/btnText"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:src="@drawable/ic_text1" />
        <!--        btnEmoji-->
        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:src="@drawable/ic_emoji1" />

        <!--        btnSticker-->
        <ImageView
            android:id="@+id/btnSticker"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:src="@drawable/ic_sticker1" />

        <!--        btnBrush-->
        <ImageView
            android:id="@+id/btnBrush"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:src="@drawable/ic_paint1" />


        <!--        btnImage-->
        <ImageView
            android:id="@+id/btnImage"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginVertical="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_4"
            android:src="@drawable/ic_add_image1" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--        btnType1-->
        <ImageView
            android:id="@+id/btnType1"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@drawable/ic_shape_slt"
            android:src="@drawable/ic_type_1" />

        <!--        btnType2-->
        <ImageView
            android:id="@+id/btnType2"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@drawable/ic_shape_uslt"
            android:src="@drawable/ic_type_2" />

        <!--        btnType3-->
        <ImageView
            android:id="@+id/btnType3"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@drawable/ic_shape_uslt"
            android:src="@drawable/ic_type_3" />

        <!--        btnType4-->
        <ImageView
            android:id="@+id/btnType4"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@drawable/ic_shape_uslt"
            android:src="@drawable/ic_type_4" />
    </LinearLayout>

    <!--    flNativeCollab-->
    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
