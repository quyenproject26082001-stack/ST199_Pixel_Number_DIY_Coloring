<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_112"
    android:layout_margin="@dimen/dp_5"
    app:cardBackgroundColor="@color/pixel_card"
    app:cardCornerRadius="@dimen/dp_14"
    app:cardElevation="0dp"
    app:strokeColor="@color/pixel_card_stroke"
    app:strokeWidth="@dimen/dp_1">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_8" />
        <TextView
            android:id="@+id/tvCompleted"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/dp_8"
            android:background="@drawable/bg_pixel_complete_badge"
            android:gravity="center"
            android:text="@string/pixel_complete_mark"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
