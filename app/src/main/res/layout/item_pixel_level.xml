<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/pixel_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pixel_card_stroke"
    app:strokeWidth="1dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <com.skin.rbx.clothes.makek.ui.pixel_coloring.PixelPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp" />
        <TextView
            android:id="@+id/tvCompleted"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pixel_complete_badge"
            android:gravity="center"
            android:text="@string/pixel_complete_mark"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
