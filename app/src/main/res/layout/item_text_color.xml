<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginEnd="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.skin.rbx.clothes.makek.core.custom.layout.TextColorClipLayout
            android:id="@+id/colorClip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/selector_text_color_border"
            android:layout_margin="0dp"
            >

            <!--            imvColor-->
            <ImageView
                android:id="@+id/imvColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="0dp" />

            <!--            btnAddColor-->
            <ImageView
                android:id="@+id/btnAddColor"
                android:layout_width="match_parent"
                android:layout_margin="1dp"
                android:layout_height="match_parent"
                android:src="@drawable/img0text_color"
                android:layout_gravity="center"
                tools:visibility="visible"
                android:visibility="visible" />

        </com.skin.rbx.clothes.makek.core.custom.layout.TextColorClipLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
