<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearance.LeftRoundedCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/dp_28</item>
        <item name="cornerSizeBottomLeft">@dimen/dp_28</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BaseProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="CutCornerCardShape" parent="" tools:keep="@style/CutCornerCardShape">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">@dimen/dp_12</item>
    </style>

    <style name="border_image_5" parent="" tools:keep="@style/border_image_5">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_5</item>
    </style>

    <style name="border_image_6" parent="" tools:keep="@style/border_image_6">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_4</item>
    </style>

    <style name="border_image_99" parent="" tools:keep="@style/border_image_99">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_99</item>
    </style>

    <style name="ShapeAppearanceOverlay.Pony.Rounded20" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_40</item>
    </style>

    <style name="single_marquee">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <style name="BaseDialog" parent="Theme.AppCompat.Light.Dialog.Alert" tools:keep="@style/BaseDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_25</item>
    </style>

    <style name="Theme.BaseProject" parent="Base.Theme.BaseProject" />
    <style name="PixelCategoryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">@dimen/dp_130</item>
        <item name="android:layout_height">@dimen/dp_44</item>
        <item name="android:layout_marginEnd">@dimen/dp_8</item>
        <item name="android:background">@drawable/selector_pixel_category_tab</item>
        <item name="backgroundTint">@null</item>
        <item name="android:fontFamily">@font/game_paused_demo_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app</item>
        <item name="android:textSize">@dimen/sp_16</item>
    </style>
    <style name="PixelToolButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">@dimen/dp_44</item>
        <item name="android:layout_marginStart">@dimen/dp_4</item><item name="android:layout_marginEnd">@dimen/dp_4</item><item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/selector_pixel_tool</item><item name="android:minWidth">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/white</item><item name="android:textSize">@dimen/sp_12</item>
    </style>

    <style name="OutfitSmallButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">@dimen/dp_52</item>
        <item name="android:layout_height">@dimen/dp_40</item>
        <item name="android:layout_marginHorizontal">@dimen/dp_3</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">@dimen/sp_14</item>
    </style>

    <style name="OutfitToolButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/dp_52</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">@dimen/dp_4</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">@dimen/dp_4</item>
        <item name="android:textSize">@dimen/sp_12</item>
    </style>

    <style name="OutfitEditorButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">@dimen/dp_82</item>
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:layout_marginHorizontal">@dimen/dp_3</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">@dimen/dp_4</item>
        <item name="android:textSize">@dimen/sp_11</item>
    </style>

    <style name="OutfitColorSwatch">
        <item name="android:layout_width">@dimen/dp_32</item>
        <item name="android:layout_height">@dimen/dp_32</item>
        <item name="android:layout_marginHorizontal">@dimen/dp_5</item>
    </style>
</resources>
