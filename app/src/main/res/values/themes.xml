<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearance.LeftRoundedCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BaseProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="CutCornerCardShape" parent="" tools:keep="@style/CutCornerCardShape">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="border_image_5" parent="" tools:keep="@style/border_image_5">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="border_image_6" parent="" tools:keep="@style/border_image_6">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="border_image_99" parent="" tools:keep="@style/border_image_99">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">99dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Pony.Rounded20" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">40dp</item>
    </style>

    <style name="single_marquee">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <style name="BaseDialog" parent="Theme.AppCompat.Light.Dialog.Alert" tools:keep="@style/BaseDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">25dp</item>
    </style>

    <style name="Theme.BaseProject" parent="Base.Theme.BaseProject" />
    <style name="PixelCategoryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_pixel_category_tab</item>
        <item name="backgroundTint">@null</item>
        <item name="android:fontFamily">@font/game_paused_demo_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/app</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="PixelToolButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item><item name="android:layout_marginEnd">4dp</item><item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/selector_pixel_tool</item><item name="android:minWidth">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/white</item><item name="android:textSize">12sp</item>
    </style>

    <style name="OutfitSmallButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OutfitToolButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="OutfitEditorButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">82dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="OutfitColorSwatch">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
    </style>
</resources>
