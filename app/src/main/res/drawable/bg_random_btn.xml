<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#243CB2"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <item
        android:right="1dp"
        android:left="1dp"
        android:bottom="1dp"
        android:top="1dp"
        >
        <shape android:shape="rectangle">
            <corners android:radius="23dp"/>
            <solid android:color="#1940FF"/>
        </shape>
    </item>

    <item
        android:right="4dp"
        android:left="4dp"
        android:top="4dp"
        android:bottom="4dp"
        >
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#7F94FE"/>
        </shape>
    </item>
</layer-list>